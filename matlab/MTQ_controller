function [T_mtq,m_cmd]  = mtq_controller(B_dot, B_body, k_mtq, m_max, alpha, dump_flag)
%MTQ_CONTROLLER  Magnetorquer torque during desaturation
%
%  Inputs:
%    B_body    [3x1]  geomagnetic field in body frame [T]
%    B_dot     [3x1]  derivative of B_body [T/s]
%    dump_flag [1x1]  1 = desaturation active
%    alpha     [1x1]  blending factor 0~1 from saturation_trigger
%    k_mtq     [1x1]  B-dot gain [A·m²·s/T]
%    m_max     [1x1]  max magnetic moment per axis [A·m²]
%
%  Outputs:
%    T_mtq     [3x1]  MTQ torque in body frame [N·m]
%    m_cmd     [3x1]  commanded magnetic moment [A·m²]

if ~dump_flag
    T_mtq = zeros(3,1);
    m_cmd = zeros(3,1);
    return;
end

%% Step 1: B-dot law (eq. 2-7)
m_raw = -k_mtq * B_dot;

%% Step 2: Project perpendicular to B (eq. 2-6) — only perpendicular component creates torque
b_norm_sq = dot(B_body, B_body) + 1e-30;
m_perp    = m_raw - (dot(m_raw, B_body) / b_norm_sq) * B_body;

%% Step 3: Clamp each axis to hardware limit
m_cmd = max(-m_max, min(m_max, m_perp));

%% Step 4: Compute torque via skew-symmetric cross product (eq. 2-4)
T_mtq_full = skew(m_cmd) * B_body;

%% Step 5: Apply alpha blending (smooth activation)
T_mtq = alpha * T_mtq_full;

end

%% Helper: skew-symmetric matrix
function S = skew(v)
S = [ 0    -v(3)  v(2);
      v(3)  0    -v(1);
     -v(2)  v(1)  0  ];
end
